# Copy to .env.local only on your own computer; .env.local is ignored by Git.
DB_URL=jdbc:postgresql://localhost:5432/comic_db
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_LOCALLY
# Generate a unique random value of at least 32 bytes. Never use a public/default key.
JWT_SECRET=GENERATE_A_UNIQUE_RANDOM_SECRET_LOCALLY

# Leave blank unless email verification is configured.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Bootstrap Admin values are passed to the process once by tools/bootstrap_admin_windows.ps1.
# Never put ADMIN_BOOTSTRAP_PASSWORD in .env.local or in source control.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Only needed for Flutter Web/admin browser origins; native Android is not subject to browser CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
